<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CourseCreation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="12.0.0">
  <bpmn:collaboration id="Collaboration_CourseCreation">
    <bpmn:participant id="Participant_EduPortal" name="Система ЕдуПортал (Створення курсу)" processRef="Process_CourseCreation" />
  </bpmn:collaboration>
  <bpmn:process id="Process_CourseCreation" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Course">
      <bpmn:lane id="Lane_Manager" name="Менеджер курсів">
        <bpmn:flowNodeRef>Start_Course</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateShell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AuditCourse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AuditCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyRework</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Teacher" name="Викладач">
        <bpmn:flowNodeRef>Gateway_XOR_ReworkMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Fork_Content</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddLectures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddAssignments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddQuizzes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddForum</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Join_Content</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfigureEnrollment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Система LMS">
        <bpmn:flowNodeRef>Task_PublishCourse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_CoursePublished</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Course" name="Отримано заявку на створення курсу">
      <bpmn:outgoing>Flow_C1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_CreateShell" name="Створити курс у категорії та призначити викладача">
      <bpmn:incoming>Flow_C1</bpmn:incoming>
      <bpmn:outgoing>Flow_C2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_CourseMat">
        <bpmn:targetRef>DataObjectRef_CourseMat</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_XOR_ReworkMerge" name="Синхронізація входу/повернення">
      <bpmn:incoming>Flow_C2</bpmn:incoming>
      <bpmn:incoming>Flow_C_Rework</bpmn:incoming>
      <bpmn:outgoing>Flow_C_ToFork</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_Fork_Content" name="Паралельне наповнення компонентів курсу">
      <bpmn:incoming>Flow_C_ToFork</bpmn:incoming>
      <bpmn:outgoing>Flow_Fork_Lec</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fork_Ass</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fork_Quiz</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fork_Forum</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_AddLectures" name="Завантажити лекційні ресурси та матеріали">
      <bpmn:incoming>Flow_Fork_Lec</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Lec</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AddAssignments" name="Створити практичні завдання та дедлайни">
      <bpmn:incoming>Flow_Fork_Ass</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Ass</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AddQuizzes" name="Сформувати банк тестових питань та шкалу">
      <bpmn:incoming>Flow_Fork_Quiz</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Quiz</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AddForum" name="Налаштувати консультаційний форум курсу">
      <bpmn:incoming>Flow_Fork_Forum</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Forum</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_Join_Content" name="Синхронізація завершення наповнення">
      <bpmn:incoming>Flow_Join_Lec</bpmn:incoming>
      <bpmn:incoming>Flow_Join_Ass</bpmn:incoming>
      <bpmn:incoming>Flow_Join_Quiz</bpmn:incoming>
      <bpmn:incoming>Flow_Join_Forum</bpmn:incoming>
      <bpmn:outgoing>Flow_C3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_ConfigureEnrollment" name="Налаштувати методи зарахування та кодове слово">
      <bpmn:incoming>Flow_C3</bpmn:incoming>
      <bpmn:outgoing>Flow_C4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AuditCourse" name="Провести аудит наповнення та налаштувань курсу">
      <bpmn:incoming>Flow_C4</bpmn:incoming>
      <bpmn:outgoing>Flow_C5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_AuditCheck" name="Вимоги до курсу виконано?" default="Flow_Audit_No">
      <bpmn:incoming>Flow_C5</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Audit_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_NotifyRework" name="Надіслати зауваження викладачу на доопрацювання">
      <bpmn:incoming>Flow_Audit_No</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Rework</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_PublishCourse" name="Опублікувати курс та відкрити доступ у каталозі">
      <bpmn:incoming>Flow_Audit_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_C6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_CoursePublished" name="Курс успішно опубліковано у каталозі">
      <bpmn:incoming>Flow_C6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="DataObjectRef_CourseMat" name="Програма та матеріали навчального курсу" dataObjectRef="DO_CourseMat" />
    <bpmn:dataObject id="DO_CourseMat" />
    <bpmn:sequenceFlow id="Flow_C1" sourceRef="Start_Course" targetRef="Task_CreateShell" />
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="Task_CreateShell" targetRef="Gateway_XOR_ReworkMerge" />
    <bpmn:sequenceFlow id="Flow_C_ToFork" sourceRef="Gateway_XOR_ReworkMerge" targetRef="Gateway_Fork_Content" />
    <bpmn:sequenceFlow id="Flow_Fork_Lec" sourceRef="Gateway_Fork_Content" targetRef="Task_AddLectures" />
    <bpmn:sequenceFlow id="Flow_Fork_Ass" sourceRef="Gateway_Fork_Content" targetRef="Task_AddAssignments" />
    <bpmn:sequenceFlow id="Flow_Fork_Quiz" sourceRef="Gateway_Fork_Content" targetRef="Task_AddQuizzes" />
    <bpmn:sequenceFlow id="Flow_Fork_Forum" sourceRef="Gateway_Fork_Content" targetRef="Task_AddForum" />
    <bpmn:sequenceFlow id="Flow_Join_Lec" sourceRef="Task_AddLectures" targetRef="Gateway_Join_Content" />
    <bpmn:sequenceFlow id="Flow_Join_Ass" sourceRef="Task_AddAssignments" targetRef="Gateway_Join_Content" />
    <bpmn:sequenceFlow id="Flow_Join_Quiz" sourceRef="Task_AddQuizzes" targetRef="Gateway_Join_Content" />
    <bpmn:sequenceFlow id="Flow_Join_Forum" sourceRef="Task_AddForum" targetRef="Gateway_Join_Content" />
    <bpmn:sequenceFlow id="Flow_C3" sourceRef="Gateway_Join_Content" targetRef="Task_ConfigureEnrollment" />
    <bpmn:sequenceFlow id="Flow_C4" sourceRef="Task_ConfigureEnrollment" targetRef="Task_AuditCourse" />
    <bpmn:sequenceFlow id="Flow_C5" sourceRef="Task_AuditCourse" targetRef="Gateway_AuditCheck" />
    <bpmn:sequenceFlow id="Flow_Audit_Yes" name="Так" sourceRef="Gateway_AuditCheck" targetRef="Task_PublishCourse" />
    <bpmn:sequenceFlow id="Flow_Audit_No" name="Ні" sourceRef="Gateway_AuditCheck" targetRef="Task_NotifyRework" />
    <bpmn:sequenceFlow id="Flow_C_Rework" sourceRef="Task_NotifyRework" targetRef="Gateway_XOR_ReworkMerge" />
    <bpmn:sequenceFlow id="Flow_C6" sourceRef="Task_PublishCourse" targetRef="End_CoursePublished" />
    <bpmn:textAnnotation id="TextAnnotation_2">
      <bpmn:text>Паралельне формування контенту згідно зі стандартом дисципліни</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_2" sourceRef="TextAnnotation_2" targetRef="Gateway_Fork_Content" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_2">
    <bpmndi:BPMNPlane id="BPMNPlane_2" bpmnElement="Collaboration_CourseCreation">
      <bpmndi:BPMNShape id="Participant_EduPortal_di" bpmnElement="Participant_EduPortal" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1340" height="580" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Manager_di" bpmnElement="Lane_Manager" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1310" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Teacher_di" bpmnElement="Lane_Teacher" isHorizontal="true">
        <dc:Bounds x="190" y="250" width="1310" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="190" y="530" width="1310" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Course_di" bpmnElement="Start_Course">
        <dc:Bounds x="232" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="206" y="175" width="88" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateShell_di" bpmnElement="Task_CreateShell">
        <dc:Bounds x="310" y="110" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_XOR_ReworkMerge_di" bpmnElement="Gateway_XOR_ReworkMerge" isMarkerVisible="true">
        <dc:Bounds x="430" y="365" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="415" y="422" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Fork_Content_di" bpmnElement="Gateway_Fork_Content">
        <dc:Bounds x="520" y="365" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="508" y="422" width="75" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AddLectures_di" bpmnElement="Task_AddLectures">
        <dc:Bounds x="610" y="270" width="130" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AddAssignments_di" bpmnElement="Task_AddAssignments">
        <dc:Bounds x="610" y="330" width="130" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AddQuizzes_di" bpmnElement="Task_AddQuizzes">
        <dc:Bounds x="610" y="390" width="130" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AddForum_di" bpmnElement="Task_AddForum">
        <dc:Bounds x="610" y="450" width="130" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Join_Content_di" bpmnElement="Gateway_Join_Content">
        <dc:Bounds x="780" y="365" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="768" y="422" width="75" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConfigureEnrollment_di" bpmnElement="Task_ConfigureEnrollment">
        <dc:Bounds x="860" y="350" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AuditCourse_di" bpmnElement="Task_AuditCourse">
        <dc:Bounds x="860" y="110" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AuditCheck_di" bpmnElement="Gateway_AuditCheck" isMarkerVisible="true">
        <dc:Bounds x="1030" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1018" y="95" width="75" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyRework_di" bpmnElement="Task_NotifyRework">
        <dc:Bounds x="1120" y="110" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PublishCourse_di" bpmnElement="Task_PublishCourse">
        <dc:Bounds x="1120" y="555" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_CoursePublished_di" bpmnElement="End_CoursePublished">
        <dc:Bounds x="1290" y="577" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1270" y="620" width="77" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObjectRef_CourseMat_di" bpmnElement="DataObjectRef_CourseMat">
        <dc:Bounds x="362" y="15" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="340" y="-10" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TextAnnotation_2_di" bpmnElement="TextAnnotation_2">
        <dc:Bounds x="500" y="540" width="170" height="55" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_C1_di" bpmnElement="Flow_C1">
        <di:waypoint x="268" y="150" />
        <di:waypoint x="310" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C2_di" bpmnElement="Flow_C2">
        <di:waypoint x="380" y="190" />
        <di:waypoint x="380" y="390" />
        <di:waypoint x="430" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C_ToFork_di" bpmnElement="Flow_C_ToFork">
        <di:waypoint x="480" y="390" />
        <di:waypoint x="520" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fork_Lec_di" bpmnElement="Flow_Fork_Lec">
        <di:waypoint x="545" y="365" />
        <di:waypoint x="545" y="295" />
        <di:waypoint x="610" y="295" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fork_Ass_di" bpmnElement="Flow_Fork_Ass">
        <di:waypoint x="560" y="380" />
        <di:waypoint x="560" y="355" />
        <di:waypoint x="610" y="355" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fork_Quiz_di" bpmnElement="Flow_Fork_Quiz">
        <di:waypoint x="560" y="400" />
        <di:waypoint x="560" y="415" />
        <di:waypoint x="610" y="415" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fork_Forum_di" bpmnElement="Flow_Fork_Forum">
        <di:waypoint x="545" y="415" />
        <di:waypoint x="545" y="475" />
        <di:waypoint x="610" y="475" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Join_Lec_di" bpmnElement="Flow_Join_Lec">
        <di:waypoint x="740" y="295" />
        <di:waypoint x="805" y="295" />
        <di:waypoint x="805" y="365" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Join_Ass_di" bpmnElement="Flow_Join_Ass">
        <di:waypoint x="740" y="355" />
        <di:waypoint x="790" y="355" />
        <di:waypoint x="790" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Join_Quiz_di" bpmnElement="Flow_Join_Quiz">
        <di:waypoint x="740" y="415" />
        <di:waypoint x="790" y="415" />
        <di:waypoint x="790" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Join_Forum_di" bpmnElement="Flow_Join_Forum">
        <di:waypoint x="740" y="475" />
        <di:waypoint x="805" y="475" />
        <di:waypoint x="805" y="415" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C3_di" bpmnElement="Flow_C3">
        <di:waypoint x="830" y="390" />
        <di:waypoint x="860" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C4_di" bpmnElement="Flow_C4">
        <di:waypoint x="925" y="350" />
        <di:waypoint x="925" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C5_di" bpmnElement="Flow_C5">
        <di:waypoint x="990" y="150" />
        <di:waypoint x="1030" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Audit_Yes_di" bpmnElement="Flow_Audit_Yes">
        <di:waypoint x="1055" y="175" />
        <di:waypoint x="1055" y="595" />
        <di:waypoint x="1120" y="595" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1061" y="203" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Audit_No_di" bpmnElement="Flow_Audit_No">
        <di:waypoint x="1080" y="150" />
        <di:waypoint x="1120" y="150" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1094" y="132" width="12" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C_Rework_di" bpmnElement="Flow_C_Rework">
        <di:waypoint x="1185" y="110" />
        <di:waypoint x="1185" y="60" />
        <di:waypoint x="455" y="60" />
        <di:waypoint x="455" y="365" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C6_di" bpmnElement="Flow_C6">
        <di:waypoint x="1250" y="595" />
        <di:waypoint x="1290" y="595" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Association_2_di" bpmnElement="Association_2">
        <di:waypoint x="570" y="540" />
        <di:waypoint x="550" y="410" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

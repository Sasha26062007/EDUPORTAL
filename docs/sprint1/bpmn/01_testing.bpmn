      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_LMS_di" bpmnElement="Participant_LMS" isHorizontal="true">
        <dc:Bounds x="160" y="430" width="1380" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_LMS_di" bpmnElement="Lane_LMS" isHorizontal="true">
        <dc:Bounds x="190" y="430" width="1350" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_LMS_di" bpmnElement="Start_LMS">
        <dc:Bounds x="342" y="522" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="320" y="565" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LMS_Check_di" bpmnElement="Task_LMS_Check">
        <dc:Bounds x="420" y="500" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_LMS_Attempts_di" bpmnElement="Gateway_LMS_Attempts" isMarkerVisible="true">
        <dc:Bounds x="590" y="515" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="585" y="485" width="60" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LMS_Reject_di" bpmnElement="Task_LMS_Reject">
        <dc:Bounds x="680" y="595" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_LMS_Rejected_di" bpmnElement="End_LMS_Rejected">
        <dc:Bounds x="850" y="612" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="835" y="655" width="66" height="27" />

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Testing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="12.0.0">
  <bpmn:collaboration id="Collaboration_Testing">
    <bpmn:participant id="Participant_Student" name="Студент" processRef="Process_Student" />
    <bpmn:participant id="Participant_LMS" name="Система LMS (ЕдуПортал)" processRef="Process_LMS" />
    <bpmn:messageFlow id="Flow_Msg_Start" name="Запит на запуск тесту" sourceRef="Task_Student_Request" targetRef="Start_LMS" />
    <bpmn:messageFlow id="Flow_Msg_Questions" name="Бланк питань і таймер" sourceRef="Task_LMS_Generate" targetRef="Event_Student_CatchQuestions" />
    <bpmn:messageFlow id="Flow_Msg_Submit" name="Відправлені відповіді" sourceRef="Task_Student_Submit" targetRef="Task_LMS_Score" />
    <bpmn:messageFlow id="Flow_Msg_Result" name="Підсумковий бал та ECTS" sourceRef="Task_LMS_Notify" targetRef="Event_Student_CatchResult" />
    <bpmn:messageFlow id="Flow_Msg_NoAttempts" name="Сповіщення про вичерпання спроб" sourceRef="Task_LMS_Reject" targetRef="Event_Student_CatchNoAttempts" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Student" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Student">
      <bpmn:lane id="Lane_Student" name="Студент">
        <bpmn:flowNodeRef>Start_Student</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Student_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Student_WaitStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Student_CatchNoAttempts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Student_NoAttempts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Student_CatchQuestions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_Quiz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Student_WaitEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Student_Manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Student_Timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Student_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Student_CatchResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Student_Success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Student" name="Бажання пройти тестування">
      <bpmn:outgoing>Flow_St1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_Student_Request" name="Натиснути кнопку Почати спробу">
      <bpmn:incoming>Flow_St1</bpmn:incoming>
      <bpmn:outgoing>Flow_St2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Gateway_Student_WaitStart" name="Очікування допуску">
      <bpmn:incoming>Flow_St2</bpmn:incoming>
      <bpmn:outgoing>Flow_St_BranchPass</bpmn:outgoing>
      <bpmn:outgoing>Flow_St_BranchReject</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_Student_CatchNoAttempts" name="Отримано відмову (спроби вичерпано)">
      <bpmn:incoming>Flow_St_BranchReject</bpmn:incoming>
      <bpmn:outgoing>Flow_St_ToEndReject</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_NoAttempts" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Student_NoAttempts" name="Спроби вичерпано — доступ закрито">
      <bpmn:incoming>Flow_St_ToEndReject</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Event_Student_CatchQuestions" name="Отримано сторінки питань і таймер">
      <bpmn:incoming>Flow_St_BranchPass</bpmn:incoming>
      <bpmn:outgoing>Flow_St_ToSub</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_CatchQuestions" />
    </bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="SubProcess_Quiz" name="Підпроцес опрацювання питань тесту">
      <bpmn:incoming>Flow_St_ToSub</bpmn:incoming>
      <bpmn:outgoing>Flow_St3</bpmn:outgoing>
      <bpmn:startEvent id="Start_SubQ" name="Початок відповідей">
        <bpmn:outgoing>Flow_SubQ1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Task_Sub_Answer" name="Обрати варіанти відповідей">
        <bpmn:incoming>Flow_SubQ1</bpmn:incoming>
        <bpmn:outgoing>Flow_SubQ2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_Sub_Save" name="Зберегти відповідь на питання">
        <bpmn:incoming>Flow_SubQ2</bpmn:incoming>
        <bpmn:outgoing>Flow_SubQ3</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="End_SubQ" name="Питання опрацьовано">
        <bpmn:incoming>Flow_SubQ3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_SubQ1" sourceRef="Start_SubQ" targetRef="Task_Sub_Answer" />
      <bpmn:sequenceFlow id="Flow_SubQ2" sourceRef="Task_Sub_Answer" targetRef="Task_Sub_Save" />
      <bpmn:sequenceFlow id="Flow_SubQ3" sourceRef="Task_Sub_Save" targetRef="End_SubQ" />
    </bpmn:subProcess>
    <bpmn:eventBasedGateway id="Gateway_Student_WaitEnd" name="Контроль завершення">
      <bpmn:incoming>Flow_St3</bpmn:incoming>
      <bpmn:outgoing>Flow_St_ManualFinish</bpmn:outgoing>
      <bpmn:outgoing>Flow_St_TimerFinish</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_Student_Manual" name="Студент натиснув Завершити тест">
      <bpmn:incoming>Flow_St_ManualFinish</bpmn:incoming>
      <bpmn:outgoing>Flow_St4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Manual" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_Student_Timer" name="Таймер: час спроби вичерпано">
      <bpmn:incoming>Flow_St_TimerFinish</bpmn:incoming>
      <bpmn:outgoing>Flow_St5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_QuizTimer" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Task_Student_Submit" name="Відправити бланк відповідей на перевірку">
      <bpmn:incoming>Flow_St4</bpmn:incoming>
      <bpmn:incoming>Flow_St5</bpmn:incoming>
      <bpmn:outgoing>Flow_St6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_QuizSheet">
        <bpmn:targetRef>DataObjectRef_QuizSheet</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_Student_CatchResult" name="Отримано підсумковий бал">
      <bpmn:incoming>Flow_St6</bpmn:incoming>
      <bpmn:outgoing>Flow_St7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_CatchResult" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Student_Success" name="Тестування завершено, результат переглянуто">
      <bpmn:incoming>Flow_St7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="DataObjectRef_QuizSheet" name="Бланк відповідей на тест" dataObjectRef="DO_QuizSheet" />
    <bpmn:dataObject id="DO_QuizSheet" />
    <bpmn:sequenceFlow id="Flow_St1" sourceRef="Start_Student" targetRef="Task_Student_Request" />
    <bpmn:sequenceFlow id="Flow_St2" sourceRef="Task_Student_Request" targetRef="Gateway_Student_WaitStart" />
    <bpmn:sequenceFlow id="Flow_St_BranchReject" sourceRef="Gateway_Student_WaitStart" targetRef="Event_Student_CatchNoAttempts" />
    <bpmn:sequenceFlow id="Flow_St_ToEndReject" sourceRef="Event_Student_CatchNoAttempts" targetRef="End_Student_NoAttempts" />
    <bpmn:sequenceFlow id="Flow_St_BranchPass" sourceRef="Gateway_Student_WaitStart" targetRef="Event_Student_CatchQuestions" />
    <bpmn:sequenceFlow id="Flow_St_ToSub" sourceRef="Event_Student_CatchQuestions" targetRef="SubProcess_Quiz" />
    <bpmn:sequenceFlow id="Flow_St3" sourceRef="SubProcess_Quiz" targetRef="Gateway_Student_WaitEnd" />
    <bpmn:sequenceFlow id="Flow_St_ManualFinish" sourceRef="Gateway_Student_WaitEnd" targetRef="Event_Student_Manual" />
    <bpmn:sequenceFlow id="Flow_St_TimerFinish" sourceRef="Gateway_Student_WaitEnd" targetRef="Event_Student_Timer" />
    <bpmn:sequenceFlow id="Flow_St4" sourceRef="Event_Student_Manual" targetRef="Task_Student_Submit" />
    <bpmn:sequenceFlow id="Flow_St5" sourceRef="Event_Student_Timer" targetRef="Task_Student_Submit" />
    <bpmn:sequenceFlow id="Flow_St6" sourceRef="Task_Student_Submit" targetRef="Event_Student_CatchResult" />
    <bpmn:sequenceFlow id="Flow_St7" sourceRef="Event_Student_CatchResult" targetRef="End_Student_Success" />
  </bpmn:process>
  <bpmn:process id="Process_LMS" isExecutable="false">
    <bpmn:laneSet id="LaneSet_LMS">
      <bpmn:lane id="Lane_LMS" name="Сервіси LMS">
        <bpmn:flowNodeRef>Start_LMS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LMS_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_LMS_Attempts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LMS_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_LMS_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LMS_Generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LMS_Score</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LMS_Journal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LMS_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_LMS_Success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_LMS" name="Отримано запит на запуск тесту">
      <bpmn:outgoing>Flow_L1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_LMSStart" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_LMS_Check" name="Перевірити вікно доступності та ліміт спроб">
      <bpmn:incoming>Flow_L1</bpmn:incoming>
      <bpmn:outgoing>Flow_L2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_LMS_Attempts" name="Спроби доступні?" default="Flow_L_No">
      <bpmn:incoming>Flow_L2</bpmn:incoming>
      <bpmn:outgoing>Flow_L_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_L_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_LMS_Reject" name="Надіслати сповіщення про вичерпання спроб">
      <bpmn:incoming>Flow_L_No</bpmn:incoming>
      <bpmn:outgoing>Flow_L_EndRej</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_LMS_Rejected" name="Спробу заблоковано">
      <bpmn:incoming>Flow_L_EndRej</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_LMS_Generate" name="Згенерувати тестові питання та запустити таймер">
      <bpmn:incoming>Flow_L_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_L3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_LMS_Score" name="Розрахувати бали за алгоритмом QuizScorer">
      <bpmn:incoming>Flow_L3</bpmn:incoming>
      <bpmn:outgoing>Flow_L4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_LMS_Journal" name="Записати результат у журнал оцінок">
      <bpmn:incoming>Flow_L4</bpmn:incoming>
      <bpmn:outgoing>Flow_L5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_LMS_Notify" name="Надіслати підсумковий бал та ECTS">
      <bpmn:incoming>Flow_L5</bpmn:incoming>
      <bpmn:outgoing>Flow_L6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_LMS_Success" name="Оцінювання тесту завершено">
      <bpmn:incoming>Flow_L6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_L1" sourceRef="Start_LMS" targetRef="Task_LMS_Check" />
    <bpmn:sequenceFlow id="Flow_L2" sourceRef="Task_LMS_Check" targetRef="Gateway_LMS_Attempts" />
    <bpmn:sequenceFlow id="Flow_L_Yes" name="Так" sourceRef="Gateway_LMS_Attempts" targetRef="Task_LMS_Generate" />
    <bpmn:sequenceFlow id="Flow_L_No" name="Ні" sourceRef="Gateway_LMS_Attempts" targetRef="Task_LMS_Reject" />
    <bpmn:sequenceFlow id="Flow_L_EndRej" sourceRef="Task_LMS_Reject" targetRef="End_LMS_Rejected" />
    <bpmn:sequenceFlow id="Flow_L3" sourceRef="Task_LMS_Generate" targetRef="Task_LMS_Score" />
    <bpmn:sequenceFlow id="Flow_L4" sourceRef="Task_LMS_Score" targetRef="Task_LMS_Journal" />
    <bpmn:sequenceFlow id="Flow_L5" sourceRef="Task_LMS_Journal" targetRef="Task_LMS_Notify" />
    <bpmn:sequenceFlow id="Flow_L6" sourceRef="Task_LMS_Notify" targetRef="End_LMS_Success" />
    <bpmn:textAnnotation id="TextAnnotation_1">
      <bpmn:text>Автоматичне нарахування часткових балів за алгоритмом QuizScorer</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1" sourceRef="TextAnnotation_1" targetRef="Task_LMS_Score" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Testing">
      <bpmndi:BPMNShape id="Participant_Student_di" bpmnElement="Participant_Student" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1380" height="310" />
